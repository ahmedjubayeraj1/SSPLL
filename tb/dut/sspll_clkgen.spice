xx4nb out dly VSS VSS sky130_fd_pr__nfet_01v8 w=0.840 l=0.15 nf=1 m=1 ad=0.2436 as=0.2436 pd=2.260 ps=2.260
xx4pa x4_x inb VDD VDD sky130_fd_pr__pfet_01v8 w=1.680 l=0.15 nf=1 m=1 ad=0.4872 as=0.4872 pd=3.940 ps=3.940
xx4pb out dly x4_x VDD sky130_fd_pr__pfet_01v8 w=1.680 l=0.15 nf=1 m=1 ad=0.4872 as=0.4872 pd=3.940 ps=3.940
.ends
.subckt sspll_ckg_pulse_g in out VDD VSS
